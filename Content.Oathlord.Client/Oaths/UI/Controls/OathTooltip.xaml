<PanelContainer xmlns="https://spacestation14.io"
    xmlns:graphics="using:Robust.Client.Graphics"
    xmlns:controls="using:Content.Client.UserInterface.Controls">
    <PanelContainer.PanelOverride>
        <graphics:StyleBoxFlat BackgroundColor="#252525"/>
    </PanelContainer.PanelOverride>
    <BoxContainer Orientation="Vertical" SeparationOverride="2">
        <Label Name="OathNameLabel" StyleClasses="LabelHeadingBigger" HorizontalAlignment="Center" Margin="8"/>
        <controls:Separator StyleClasses="highlight" Thickness="2" Margin="8 0" />
        <RichTextLabel Name="OathDescLabel" MaxWidth="600" StyleClasses="TooltipDesc" Margin="16"/>
    </BoxContainer>
</PanelContainer>
