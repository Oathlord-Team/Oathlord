<widgets:SpellsButton
    xmlns="https://spacestation14.io"
    xmlns:widgets="using:Content.Oathlord.Client.UserInterface.Systems.Spells.Widgets"
    xmlns:spells="using:Content.Oathlord.Client.UserInterface.Systems.Spells.Controls"
    xmlns:controls="using:Content.Client.UserInterface.Controls"
    MinSize="64 98"
    Margin="20 0">
    <BoxContainer Orientation="Vertical" VerticalExpand="True">
        <BoxContainer Align="Center" Orientation="Vertical" Margin="8">
            <Label Text="SPELLS" Align="Center" FontColorOverride="#EDEADE"/>
            <controls:Separator StyleClasses="highlight" Thickness="3"/>
        </BoxContainer>
        <spells:SpellSlot Name="SelectedSpellSlot" Access="Public" MinSize="64 86"/>
    </BoxContainer>
</widgets:SpellsButton>
