<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="using:Content.Client.UserInterface.Controls"
    Title="Attributes"
    Resizable="False"
    MinSize="600 400">
    <BoxContainer Orientation="Vertical">
        <TableContainer Name="AttributesContainer" Margin="12" Columns="16"/>
        <VBox VerticalExpand="True" VerticalAlignment="Bottom" >
            <Label Name="PointsLeftLabel" Margin="8" HorizontalAlignment="Center"/>
            <Button Text="Resolve"
                    Name="ApplyButton"
                    HorizontalAlignment="Center"
                    Margin="0 16"
                    Disabled="True"
                    ToolTip="This will apply all the changes you made to the attributes."/>
        </VBox>
    </BoxContainer>
</controls:FancyWindow>
